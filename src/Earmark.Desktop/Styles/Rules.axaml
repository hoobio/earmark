<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <x:String x:Key="RulesGlyph.ReOrder">&#xEF1F;</x:String>
        <x:String x:Key="RulesGlyph.Copy">&#xE5D7;</x:String>
        <x:String x:Key="RulesGlyph.Delete">&#xE66D;</x:String>
        <x:String x:Key="RulesGlyph.Save">&#xEF99;</x:String>
        <x:String x:Key="RulesGlyph.Undo">&#xE1A5;</x:String>
        <x:String x:Key="RulesGlyph.CheckCircle">&#xE462;</x:String>
        <x:String x:Key="RulesGlyph.Circle">&#xE494;</x:String>
        <x:String x:Key="RulesGlyph.Offline">&#xEEA3;</x:String>
    </Styles.Resources>

    <Style Selector="Border.RulesCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    </Style>
    <Style Selector="Border.RulesEditorRow">
        <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="ContentPresenter.RulesLifted > Border">
        <Setter Property="BoxShadow" Value="0 8 16 0 #42000000" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Border.RulesChip">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.RulesUnsaved">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.RulesUnsaved > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionTextBlockFontSize}" />
    </Style>
    <Style Selector="Border.RulesNotice">
        <Setter Property="Background" Value="{DynamicResource CautionTintBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.RulesPlaceholder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.RulesDragHandle">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="Text" Value="{StaticResource RulesGlyph.ReOrder}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="TextBlock.RulesDragHandle:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.RulesHint">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="Text" Value="{StaticResource Glyph.Info}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.RulesSection">
        <Setter Property="FontSize" Value="{DynamicResource BodyTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.RulesDim">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.RulesFaint">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.RulesCaution">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="TextBlock.RulesChevron">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="TextBlock.RulesChevron.Expanded">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Button.RulesIcon">
        <Setter Property="Theme" Value="{StaticResource SubtleButtonStyle}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
