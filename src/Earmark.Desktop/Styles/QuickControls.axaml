<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Earmark.Desktop.Views">
    <Styles.Resources>
        <ControlTheme x:Key="QuickControlsPanel" TargetType="ContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource WindowGroundBrush}" CornerRadius="{StaticResource OverlayCornerRadius}" ClipToBounds="True">
                        <Panel>
                            <Panel x:Name="PART_Glow" IsHitTestVisible="False">
                                <views:DitheredRadialGradient Fill="{DynamicResource GroundGlowTopLeft}" />
                                <views:DitheredRadialGradient Fill="{DynamicResource GroundGlowTopRight}" />
                            </Panel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter Margin="12" Content="{TemplateBinding Content}" />
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^.Solid /template/ Panel#PART_Glow">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
