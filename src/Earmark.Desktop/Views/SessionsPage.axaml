<UserControl
    x:Class="Earmark.Desktop.Views.SessionsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Earmark.Desktop.ViewModels"
    x:DataType="vm:SessionsViewModel"
    Padding="{StaticResource PageGutter}">
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Classes="PageTitle" Text="Sessions" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="OnRefreshClick" ToolTip.Tip="Refresh the session list">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="Glyph" Text="{StaticResource Glyph.Refresh}" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="OnReapplyClick" ToolTip.Tip="Apply every rule again now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="Glyph" Text="{StaticResource Glyph.Sync}" />
                    <TextBlock Text="Reapply rules" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Classes="Empty" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8">
            <TextBlock Classes="Glyph" Text="{StaticResource Glyph.Speaker}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Classes="BodyStrong" Text="No active sessions" HorizontalAlignment="Center" />
            <TextBlock
                Classes="Caption"
                Text="Open an app that plays or records audio (browser, media player, voice chat) and it will show up here."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionRow">
                        <Border Classes="SessionRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Panel Width="10" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding IsActive}" />
                                </Panel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="BodyStrong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="Caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Classes="Caption" Text="Routed to" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Classes="Body" Text="{Binding EndpointName}" HorizontalAlignment="Right" />
                                    <TextBlock Classes="Caption" Text="{Binding RuleCaption}" IsVisible="{Binding HasRule}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
