<UserControl
    x:Class="Earmark.Desktop.Views.SessionsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Earmark.Desktop.ViewModels"
    x:DataType="vm:SessionsViewModel"
    Padding="{StaticResource PageGutter}">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceRowTemplate" x:DataType="vm:SessionRow">
            <Border Classes="SessionRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Panel Width="10" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding IsActive}" />
                    </Panel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Classes="Caption" Text="{Binding Direction}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Classes="Body" Text="{Binding Device}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="Caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppBlockTemplate" x:DataType="vm:AppBlock">
            <Border Classes="SessionBlock">
                <StackPanel Spacing="1">
                    <Border Classes="SessionRow">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Panel Width="10" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding IsActive}" />
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="Body" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="Caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DeviceRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Classes="PageTitle" Text="Sessions" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="OnRefreshClick" ToolTip.Tip="Refresh the session list">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="Glyph" Text="{StaticResource Glyph.Refresh}" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="OnReapplyClick" ToolTip.Tip="Apply every rule again now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="Glyph" Text="{StaticResource Glyph.Sync}" />
                    <TextBlock Text="Reapply rules" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Classes="Caption" IsVisible="{Binding IsEmpty}" Text="No apps are using audio. Open an app that plays or records sound and it will show up here." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppBlockTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
